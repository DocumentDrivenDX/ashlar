  "cases": [
    {
      "id": "split-excursion",
      "original_scenario": {
        "id": "split-excursion",
        "question": "A split lot reaches two shipments and exposes temperature excursion",
        "sql": "SELECT l.lot_code,COUNT(DISTINCT s.id) FROM lots l JOIN items i ON i.lot_id=l.id JOIN shipment_items x ON x.item_id=i.id JOIN shipments s ON s.id=x.shipment_id GROUP BY l.lot_code",
        "expected": [
          [
            "LOT1",
