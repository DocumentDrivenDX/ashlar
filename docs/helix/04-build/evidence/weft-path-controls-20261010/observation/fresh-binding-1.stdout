e_system COLLATE UTF8_BINARY) = (:p5 COLLATE UTF8_BINARY) AND r.type_id = CAST(:p6 AS BIGINT)), `__weft_rel_3_source` AS (SELECT r.id AS __id, (CAST(CAST(variant_get(parse_json(r.props_json), :p12) AS STRING) AS STRING) COLLATE UTF8_BINARY) AS `f1` FROM `local_fixture`.`new_distribution`.`table_1_1` VERSION AS OF 7 r WHERE (r.source_system COLLATE UTF8_BINARY) = (:p9 COLLATE UTF8_BINARY) AND r.type_id = CAST(:p10 AS BIGINT)), `__weft_rel_4_target` AS (SELECT r.id AS __id, (CAST(CAST(variant_get(parse_json(r.props_json), :p16) AS STRING) AS STRING) COLLATE UTF8_BINARY) AS `f1` FROM `local_fixture`.`new_distribution`.`table_1_1` VERSION AS OF 7 r WHERE (r.source_system COLLATE UTF8_BINARY) = (:p13 COLLATE UTF8_BINARY) AND r.type_id = CAST(:p14 AS BIGINT)), `s0` AS (SELECT r.id AS __id, (CAST(CAST(variant_get(parse_json(r.props_json), :p20) AS STRING) AS STRING) COLLATE UTF8_BINARY) AS `f1` FROM `local_fixture`.`new_distribution`.`table_1_1` VERSION AS OF 7 r WHERE (r.source_system COLLATE UTF8_BINARY) = (:p17 COLLATE UTF8_BINARY) AND r.type_id = CAST(:p18 AS BIGINT)), `__weft_rel_2_edge` AS (SELECT e.* FROM `local_fixture`.`new_distribution`.`table_1_0` VERSION AS OF 7 e WHERE (e.source_system COLLATE UTF8_BINARY) = (:p21 COLLATE UTF8_BINARY) AND e.rel_type_id = CAST(:p22 AS BIGINT)), `__weft_rel_5_edge` AS (SELECT e.* FROM `local_fixture`.`new_distribution`.`table_1_0` VERSION AS OF 7 e WHERE (e.source_system COLLATE UTF8_BINARY) = (:p26 COLLATE UTF8_BINARY) AND e.rel_type_id = CAST(:p27 AS BIGINT)), `__weft_path_0_mid` AS (SELECT __id, (`__weft_rel_1_target`.`f1` COLLATE UTF8_BINARY) AS `m0` FROM `__weft_rel_1_target`), `__weft_path_0_terminal` AS (SELECT __id, (`__weft_rel_4_target`.`f1` COLLATE UTF8_BINARY) AS `t0` FROM `__weft_rel_4_target`), `__weft_path_0_rows` AS (SELECT e1.source_id AS __root, m.__id AS __intermediate, t.__id AS __terminal, e1.id AS __edge1, e2.id AS __edge2, `m`.`m0`, `t`.`t0` FROM `__weft_rel_2_edge` e1 JOIN `__weft_path_0_mid` m ON e1.target_id=m.__id JOIN `__weft_rel_5_edge` e2 ON e2.source_id=m.__id JOIN `__weft_path_0_terminal` t ON e2.target_id=t.__id), `__weft_path_0_ranked` AS (SELECT p.__root, named_struct('intermediate',array(CAST(`p`.`m0` AS STRING)),'terminal',array(CAST(`p`.`t0` AS STRING)),'edges',array(CAST(p.__edge1 AS STRING),CAST(p.__edge2 AS STRING))) AS __item, TRY_SUM(CAST(1 AS DECIMAL(38,0))) OVER (PARTITION BY p.__root ORDER BY `p`.`m0`, `p`.`t0`, p.__edge1, p.__edge2 ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS __ordinal FROM `__weft_path_0_rows` p), `__weft_path_0_collection` AS (SELECT __root, transform(slice(sort_array(collect_list(named_struct('ordinal',__ordinal,'item',__item))),1,2),x -> x.item) AS __items, MAX(__ordinal)>CAST(2 AS DECIMAL(38,0)) AS __truncated FROM `__weft_path_0_ranked` WHERE __ordinal<=CAST(3 AS DECIMAL(38,0)) GROUP BY __root) SELECT CAST((`s0`.`f1` COLLATE UTF8_BINARY) AS STRING) AS `id`, to_json(named_struct('items',coalesce(`__weft_path_0_collection`.__items,CAST(array() AS ARRAY<STRUCT<intermediate:ARRAY<STRING>,terminal:ARRAY<STRING>,edges:ARRAY<STRING>>>)),'truncated',coalesce(`__weft_path_0_collection`.__truncated,FALSE))) AS `paths` FROM (`s0` LEFT JOIN `__weft_path_0_collection` ON `__weft_path_0_collection`.__root=`s0`.__id) ORDER BY (`s0`.`f1` COLLATE UTF8_BINARY) ASC LIMIT 1","status":"compiled","targetContext":{"engine":"spark-sql","engineVersion":"4.0.1","id":"spark4-delta4-paths-candidate","publicationRevision":"ashlar-resolver/0.1-candidate","sessionSettings":{"comparison":"UTF8_BINARY","pathCountRepresentation":"signed64 with independent DECIMAL38 capacity","pathEdgeEncoding":"signed64-decimal/0.1","sourceValidity":"original public UMF independently; finite native capacity is separate","spark.sql.ansi.enabled":true,"spark.sql.session.timeZone":"UTC"},"storageLayoutRevision":"ashlar-delta/0.3"}}
