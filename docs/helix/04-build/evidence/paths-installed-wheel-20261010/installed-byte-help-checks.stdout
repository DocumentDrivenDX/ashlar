usage: ashlar [-h]
              {install-weft,compile-weft,install-weft-paths,compile-weft-paths,inspect-source,inspect-csv,inspect-configured-source,commerce-source,archaeology-source,ecology-source,medical-source,publish-commerce,query-commerce}
              ...

positional arguments:
  {install-weft,compile-weft,install-weft-paths,compile-weft-paths,inspect-source,inspect-csv,inspect-configured-source,commerce-source,archaeology-source,ecology-source,medical-source,publish-commerce,query-commerce}
    install-weft        Verify and install the pinned local Weft candidate
                        package
    compile-weft        Compile original stdin through a retained indexed
                        installation
    install-weft-paths  Verify and install the separately pinned Paths
                        candidate
    compile-weft-paths  Compile original stdin through a retained Paths
                        installation
    inspect-source      Verify committed JSONL batches from stdin; no ACK
    inspect-csv         Adapt bounded UTF-8 CSV to retained source
                        batches/checkpoints; no ACK
    inspect-configured-source
                        Inspect pinned model/ID/source configuration and local
                        replay; no database I/O
    commerce-source     Build an exact original commerce candidate with
                        development bindings
    archaeology-source  Build an exact original archaeology candidate with
                        development bindings
    ecology-source      Build an exact original ecology candidate with
                        development bindings
    medical-source      Build an exact historical medical candidate using
                        explicit public admission
    publish-commerce    Run the explicit local commerce native host profile
    query-commerce      Run the explicit local commerce native host profile

options:
  -h, --help            show this help message and exit
