ARY) AND r.type_id = CAST(:p2 AS BIGINT)) SELECT CAST(try_subtract(CAST(0 AS DECIMAL(38,0)), try_subtract(try_multiply(try_cast(regexp_replace(CAST(`s0`.`f1` AS STRING), '[.]', '') AS DECIMAL(38,0)), try_cast(regexp_replace(CAST(:p14 AS STRING), '[.]', '') AS DECIMAL(38,0))), try_cast(regexp_replace(CAST(:p15 AS STRING), '[.]', '') AS DECIMAL(38,0)))) AS STRING) AS `n` FROM `s0` WHERE (try_multiply(try_cast(regexp_replace(CAST(`s0`.`f1` AS STRING), '[.]', '') AS DECIMAL(38,0)), try_cast(regexp_replace(CAST(:p6 AS STRING), '[.]', '') AS DECIMAL(38,0))) < try_cast(regexp_replace(CAST(:p7 AS STRING), '[.]', '') AS DECIMAL(38,0))) AND (try_multiply(try_cast(regexp_replace(CAST(`s0`.`f1` AS STRING), '[.]', '') AS DECIMAL(38,0)), try_cast(regexp_replace(CAST(:p8 AS STRING), '[.]', '') AS DECIMAL(38,0))) <= try_cast(regexp_replace(CAST(:p9 AS STRING), '[.]', '') AS DECIMAL(38,0))) AND (try_multiply(try_cast(regexp_replace(CAST(`s0`.`f1` AS STRING), '[.]', '') AS DECIMAL(38,0)), try_cast(regexp_replace(CAST(:p10 AS STRING), '[.]', '') AS DECIMAL(38,0))) >= try_cast(regexp_replace(CAST(:p11 AS STRING), '[.]', '') AS DECIMAL(38,0))) AND (try_multiply(try_cast(regexp_replace(CAST(`s0`.`f1` AS STRING), '[.]', '') AS DECIMAL(38,0)), try_cast(regexp_replace(CAST(:p12 AS STRING), '[.]', '') AS DECIMAL(38,0))) <> try_cast(regexp_replace(CAST(:p13 AS STRING), '[.]', '') AS DECIMAL(38,0))) ORDER BY (`s0`.`f0` COLLATE UTF8_BINARY) ASC","status":"compiled","targetContext":{"engine":"spark-sql","engineVersion":"4.0.1","id":"spark4-delta4-paths-candidate","publicationRevision":"ashlar-resolver/0.1-candidate","sessionSettings":{"comparison":"UTF8_BINARY","pathCountRepresentation":"signed64 with independent DECIMAL38 capacity","pathEdgeEncoding":"signed64-decimal/0.1","sourceValidity":"original public UMF independently; finite native capacity is separate","spark.sql.ansi.enabled":true,"spark.sql.session.timeZone":"UTC"},"storageLayoutRevision":"ashlar-delta/0.3"}}
