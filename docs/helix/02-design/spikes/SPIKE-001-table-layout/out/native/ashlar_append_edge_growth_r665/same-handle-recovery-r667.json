  "original_sql": "SELECT bucket,count(*),sha2(concat_ws('',sort_array(collect_list(row_digest))),256) FROM (SELECT CASE WHEN coalesce((delivery_id RLIKE '^edge:(0|[1-9][0-9]*):1$') AND try_cast(element_at(split(delivery_id,':'),2) AS BIGINT)>=40000000 AND try_cast(element_at(split(delivery_id,':'),2) AS BIGINT)<48000000,false) THEN cast((try_cast(element_at(split(delivery_id,':'),2) AS BIGINT)-40000000) DIV 100000 AS BIGINT) ELSE cast(-1 AS BIGINT) END bucket,sha2(concat(CASE WHEN source_feed IS NULL THEN 'N;' ELSE concat('V',cast(length(encode(CAST(source_feed AS STRING),'UTF-8')) AS STRING),':',hex(encode(CAST(source_feed AS STRING),'UTF-8')),';') END,CASE WHEN source_epoch IS NULL THEN 'N;' ELSE concat('V',cast(length(encode(CAST(source_epoch AS STRING),'UTF-8')) AS STRING),':',hex(encode(CAST(source_epoch AS STRING),'UTF-8')),';') END,CASE WHEN delivery_id IS NULL THEN 'N;' ELSE concat('V',cast(length(encode(CAST(delivery_id AS STRING),'UTF-8')) AS STRING),':',hex(encode(CAST(delivery_id AS STRING),'UTF-8')),';') END,CASE WHEN record_kind IS NULL THEN 'N;' ELSE concat('V',cast(length(encode(CAST(record_kind AS STRING),'UTF-8')) AS STRING),':',hex(encode(CAST(record_kind AS STRING),'UTF-8')),';') END,CASE WHEN source_cursor_json IS NULL THEN 'N;' ELSE concat('V',cast(length(encode(CAST(source_cursor_json AS STRING),'UTF-8')) AS STRING),':',hex(encode(CAST(source_cursor_json AS STRING),'UTF-8')),';') END,CASE WHEN payload_json IS NULL THEN 'N;' ELSE concat('V',cast(length(encode(CAST(payload_json AS STRING),'UTF-8')) AS STRING),':',hex(encode(CAST(payload_json AS STRING),'UTF-8')),';') END,CASE WHEN payload_digest IS NULL THEN 'N;' ELSE concat('V',cast(length(encode(CAST(payload_digest AS STRING),'UTF-8')) AS STRING),':',hex(encode(CAST(payload_digest AS STRING),'UTF-8')),';') END,CASE WHEN schema_revision IS NULL THEN 'N;' ELSE concat('V',cast(length(encode(CAST(schema_revision AS STRING),'UTF-8')) AS STRING),':',hex(encode(CAST(schema_revision AS STRING),'UTF-8')),';') END,CASE WHEN received_at IS NULL THEN 'N;' ELSE concat('V',cast(length(encode(CAST(received_at AS STRING),'UTF-8')) AS STRING),':',hex(encode(CAST(received_at AS STRING),'UTF-8')),';') END,CASE WHEN apply_batch_id IS NULL THEN 'N;' ELSE concat('V',cast(length(encode(CAST(apply_batch_id AS STRING),'UTF-8')) AS STRING),':',hex(encode(CAST(apply_batch_id AS STRING),'UTF-8')),';') END),256) row_digest FROM client_dev.ashlar_entropy_20261006_r86.append_edge_source_record_r643 VERSION AS OF 11) GROUP BY bucket ORDER BY bucket",
  "qualification": "Same interrupted native handle; original client elapsed time unavailable, no SQL replay."
