    "query_text": "CREATE TABLE client_dev.ashlar_scale_20261006_r85.edge_stage_corrected USING DELTA AS SELECT source_system,rel_type_id,id,source_type,source_id,target_type,target_id,'synthetic-r1' schema_revision,cast(1 AS BIGINT) entity_version,\n      concat('{\"107\":true',CASE WHEN (CASE pmod(id,8)\n      WHEN 0 THEN '{}'\n      WHEN 1 THEN '{\"101\":null}'\n      WHEN 2 THEN '{\"102\":9007199254740993,\"103\":1.2300000000000000001}'\n      WHEN 3 THEN '{\"104\":\"2026-10-06T09:30:00.123456789-04:00\"}'\n      ELSE concat('{\"105\":\"',sha2(cast(id AS STRING),256),\n        repeat(sha2(concat('payload:',cast(id AS STRING)),256),cast(2+pmod(id,30) AS INT)),\n        '\",\"106\":',cast(pmod(id,100) AS STRING),'}') END)='{}' THEN '}' ELSE concat(',',substring((CASE pmod(id,8)\n      WHEN 0 THEN '{}'\n      WHEN 1 THEN '{\"101\":null}'\n      WHEN 2 THEN '{\"102\":9007199254740993,\"103\":1.2300000000000000001}'\n      WHEN 3 THEN '{\"104\":\"2026-10-06T09:30:00.123456789-04:00\"}'\n      ELSE concat('{\"105\":\"',sha2(cast(id AS STRING),256),\n        repeat(sha2(concat('payload:',cast(id AS STRING)),256),cast(2+pmod(id,30) AS INT)),\n        '\",\"106\":',cast(pmod(id,100) AS STRING),'}') END),2)) END) props_json,concat('{\"unknown\":{\"ordinal\":',cast(id AS STRING),',\"nested\":[null,true,\"opaque\"]}}') retained_json,\n      cast(NULL AS STRING) order_key,'synthetic' source_feed,'scale-1' source_epoch,cast(NULL AS BIGINT) source_position,\n      timestamp '2026-10-06 00:00:00' published_at,sha2(to_json(named_struct('source_system',source_system,'rel_type_id',rel_type_id,'id',id)),256) lookup_hash,\n      'update' apply_batch_id,\n      concat('{\"xid\":\"9007199254740993\",\"seq\":\"',cast(id AS STRING),'\"}') source_cursor_json,\n      concat('edge:',cast(id AS STRING)) source_delivery_id\n      FROM (SELECT id,CASE WHEN pmod(id,10)=0 THEN 'other' ELSE 'pilot' END source_system,cast(pmod(id,32)+1 AS BIGINT) rel_type_id,cast(pmod((pmod(id*17,400000)*10+pmod(id-1,10)+1),32)+1 AS BIGINT) source_type,cast((pmod(id*17,400000)*10+pmod(id-1,10)+1) AS BIGINT) source_id,cast(pmod((pmod(id*31+11,400000)*10+pmod(id-1,10)+1),32)+1 AS BIGINT) target_type,cast((pmod(id*31+11,400000)*10+pmod(id-1,10)+1) AS BIGINT) target_id\n      FROM (SELECT pmod(id*104729,20000000)+1 id FROM range(200000)))",
