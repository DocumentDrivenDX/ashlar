.DS_Store
.env
.env.*
!.env.example
*.pem
.venv/
node_modules/

# Local spike runtime caches and replaceable statement breadcrumbs
__pycache__/
*.py[cod]

# Microsite build output and local tooling
/website/public/
/website/.hugo_build.lock
/website/resources/
/.tools/
/build/
/dist/
# Local installations, journals and private operator inputs
/out/
/src/*.egg-info/
/.innsigle/provenance/
/.innsigle/debug/

# Run output, receipts and qualification packets are never committed. Attach them to a PR or a CI artifact.
/docs/helix/**/evidence/
/docs/helix/**/spikes/**/out/
/website/static/model/schema-browser/
*.jfr
/.ci/
